# ─────────────────────────────────────────────────────────────────────────────
# TontineClair — Podfile
# CocoaPods UNIQUEMENT — Swift Package Manager désactivé
# Flutter 3.35.4  |  Bundle ID : com.tontineclair.app
# iOS Deployment Target : 15.0
# ─────────────────────────────────────────────────────────────────────────────

platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug'   => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  # Generated.xcconfig est créé par `flutter pub get` sur la machine courante.
  # Il contient FLUTTER_ROOT= pointant vers le SDK Flutter local.
  # Ne jamais mettre de chemin absolu ici — ce fichier doit être regénéré sur chaque Mac.
  generated_xcode_build_settings_path = File.expand_path(
    File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__
  )

  unless File.exist?(generated_xcode_build_settings_path)
    raise "\n\n[TontineClair] Generated.xcconfig introuvable.\n" \
          "→ Exécuter depuis la racine du projet : flutter pub get\n" \
          "  puis relancer : pod install\n"
  end

  root = nil
  File.foreach(generated_xcode_build_settings_path) do |line|
    m = line.match(/\AFLUTTER_ROOT=(.+)/)
    root = m[1].strip if m
  end

  raise "\n\n[TontineClair] FLUTTER_ROOT introuvable dans Generated.xcconfig.\n" \
        "→ Exécuter depuis la racine du projet : flutter pub get\n" \
        "  puis relancer : pod install\n" if root.nil?

  # Garde : si Generated.xcconfig pointe vers /opt/flutter (chemin de la sandbox
  # de build — pas votre Mac), cela signifie que flutter pub get n'a pas encore
  # été exécuté sur cette machine. On lève une erreur explicite.
  if root.start_with?('/opt/flutter')
    raise "\n\n[TontineClair] Generated.xcconfig contient un chemin de sandbox (/opt/flutter).\n" \
          "→ Ce fichier doit être regénéré sur votre Mac :\n" \
          "   cd #{File.expand_path('..', File.dirname(__FILE__))}\n" \
          "   flutter pub get\n" \
          "   cd ios && pod install\n"
  end

  root
end

require File.expand_path(
  File.join('packages', 'flutter_tools', 'bin', 'podhelper'),
  flutter_root
)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # ── iOS 15.0 minimum sur tous les pods ────────────────────────────
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # ── Désactiver Bitcode (obsolète depuis Xcode 14) ─────────────────
      config.build_settings['ENABLE_BITCODE'] = 'NO'

      # ── Fix simulateur Apple Silicon M1/M2/M3 ─────────────────────────
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'

      # ── Supprimer toute référence FlutterGeneratedPluginSwiftPackage ───
      # Ce package SPM généré automatiquement par Flutter ≥ 3.24 peut
      # entrer en conflit avec CocoaPods. On force sa suppression.
      config.build_settings['SWIFT_PACKAGE_MANAGER_ENABLED'] = 'NO'

      # ── Fix warnings pods tiers ───────────────────────────────────────
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'

      # ── Smile ID : autoriser includes non-modulaires ───────────────────
      if target.name.downcase.include?('smile') || target.name.downcase.include?('smileid')
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end

      # ── Firebase : désactiver module verification ──────────────────────
      if target.name.downcase.include?('firebase') || target.name.downcase.include?('google')
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
  end

  # ── Supprimer FlutterGeneratedPluginSwiftPackage des phases de build ──────
  # Ce target SPM est parfois injecté par flutter pub get dans le workspace.
  # Si présent, il cause des erreurs "Missing package product" avec CocoaPods.
  installer.pods_project.targets.each do |target|
    target.build_phases.each do |phase|
      next unless phase.respond_to?(:files)
      phase.files.each do |build_file|
        next unless build_file.display_name&.include?('FlutterGeneratedPluginSwiftPackage')
        build_file.remove_from_project
      end
    end
  end
end
