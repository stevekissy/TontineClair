# ═══════════════════════════════════════════════════════════════════════════════
# .env.example — Fichier d'exemple des variables d'environnement TontineClair
#
# ⚠️  CE FICHIER EST UN MODÈLE — ne contient AUCUNE vraie clé.
#     Copier ce fichier en .env et remplir les vraies valeurs :
#       cp .env.example .env
#
# 🔒  Le fichier .env réel NE DOIT JAMAIS être commité dans Git.
#     Il est exclu par .gitignore.
#
# Pour Flutter Web via Netlify :
#   Ces variables sont injectées à l'étape de build via --dart-define.
#   Configurer dans Netlify UI : Site settings → Environment variables.
#
# Pour un build Flutter local :
#   flutter build web --release \
#     --dart-define=SUPABASE_URL=https://xxx.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=eyJhbGci...
# ═══════════════════════════════════════════════════════════════════════════════

# URL du projet Supabase
# Trouvable dans : Supabase Console → Project Settings → API → Project URL
SUPABASE_URL=

# Clé publique anonyme Supabase (anon key)
# ✅ Cette clé est PUBLIQUE — elle peut être utilisée côté client Flutter.
# ⚠️  Assurez-vous que les politiques RLS sont correctement configurées.
# Trouvable dans : Supabase Console → Project Settings → API → anon public
SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 🚫 NE JAMAIS inclure les clés suivantes dans une application Flutter Web :
#
#   SUPABASE_SERVICE_ROLE_KEY  → Donne un accès complet sans restriction RLS
#   DATABASE_URL / DB_PASSWORD → Accès direct PostgreSQL
#   SUPABASE_JWT_SECRET        → Permet de forger des tokens d'authentification
#
# Ces clés sont UNIQUEMENT pour des services backend (Edge Functions, serveurs).
# ─────────────────────────────────────────────────────────────────────────────
